// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// The tenant: forms, plan, and (from E29) sites belong to an Account. Users
// reach it through Membership; nothing in the UI names the Account itself.
model Account {
  id                     String        @id @default(cuid())
  createdAt              DateTime      @default(now())
  planCode               String        @default("FREE")
  requiresPlanResolution Boolean       @default(false)
  // Billing state, set by an operator (PRD D12). Billing itself happens
  // outside the portal; billingRef points there. Status gates nothing yet.
  status                 AccountStatus @default(ACTIVE)
  billingRef             String?

  plan          Plan           @relation(fields: [planCode], references: [code])
  memberships   Membership[]
  forms         Form[]
  notifications Notification[]
  site          Site?

  @@index([planCode])
  @@map("accounts")
}

// Plan catalog. Rows are seeded via migration; not user-editable at runtime.
// Account.planCode references Plan.code. Entitlements live as typed columns
// so each future entitlement is an explicit migration, not a hidden JSON
// shape change. Read them through getAccountEntitlements.
model Plan {
  code              String  @id
  displayName       String
  description       String?
  maxPublishedForms Int?
  // Canopy Sites: Sites chrome, /editor and /stats, and owning a Site.
  // Only SITES has it. The catalog is FREE, PAID ("Unlimited"), and SITES.
  sitesEnabled      Boolean @default(false)
  isPublic          Boolean @default(true)
  sortOrder         Int     @default(0)

  accounts Account[]

  @@map("plans")
}

// Role catalog. Seeded via migration; not user-editable at runtime.
// User.roleCode references Role.code. Capability flags land as typed columns
// when a second non-basic role ships.
model Role {
  code        String  @id
  displayName String
  description String?
  isPublic    Boolean @default(true)
  sortOrder   Int     @default(0)

  users User[]

  @@map("roles")
}

// Admin user account
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // scrypt, or bcrypt from before Epic 28 (re-hashed on sign-in); src/lib/password.ts
  createdAt DateTime @default(now())
  roleCode  String   @default("USER")

  memberships Membership[]

  role Role @relation(fields: [roleCode], references: [code])

  // Auth telemetry
  lastLoginAt       DateTime?
  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  passwordChangedAt DateTime?

  createdForms        Form[]               @relation("CreatedForms")
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  sessionHandoffs     SessionHandoff[]
  changeSets          ChangeSet[]
  conversations       Conversation[]

  @@index([roleCode])
  @@map("users")
}

// A user's access to an account. v1 gives every user exactly one membership,
// as OWNER; getCurrentAccountId enforces that. Platform roles (GLOBAL_ADMIN)
// stay on User.roleCode, separate from this per-account role.
model Membership {
  id        String         @id @default(cuid())
  userId    String
  accountId String
  role      MembershipRole
  createdAt DateTime       @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([accountId])
  @@map("memberships")
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum AccountStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

// A Canopy Sites website: one per account (PRD D19), only on a plan with
// sitesEnabled. Holds what the operator records about the site; the repo,
// DNS, and Umami website are made by hand. Clients see only id, name, and
// slug (getAccountSite); everything else is operator configuration.
// An account that owns a site cannot be deleted (Restrict): the row will
// drive the client's live hosting from E30 on.
model Site {
  id                  String   @id @default(cuid())
  accountId           String   @unique
  slug                String   @unique // Fixed at creation: names /srv/sites/<slug> and the builder's GIT_TOKEN_<SLUG>
  name                String
  repoUrl             String?
  defaultBranch       String   @default("main")
  productionHostnames String[] @default([]) // Lowercase; no hostname belongs to two sites (checked in the action)
  contractVersion     String? // site-contract version the repo implements (MAJOR.MINOR.PATCH)
  umamiWebsiteId      String?
  runbookOverlay      String   @default("") // Client part of the quick-edit system prompt (E32)
  lockedFields        String[] @default([]) // Dotted contract paths edits may not change (E31), e.g. site.contact.phone
  maxBuildsRetained   Int      @default(5)
  // A sales demo, never a client's site (PRD D23): Stats shows sample data.
  isDemo              Boolean  @default(false)
  // IANA zone for the site's dates: the builder rebuilds at its local midnight (PRD D42)
  timeZone            String   @default("America/Los_Angeles")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  changeSets    ChangeSet[]
  builds        Build[]
  conversations Conversation[]

  @@map("sites")
}

// One proposed edit to a site's content, from any source (PRD section 4.5).
// ops are @canopy/site-contract ChangeOps against the branch at baseCommit.
// A site has at most one pending (DRAFT or PREVIEWED) change at a time: the
// site's draft (PRD D38), which every source writes. version counts its
// saves, and publish needs a build of the current one.
model ChangeSet {
  id              String          @id @default(cuid())
  siteId          String
  source          ChangeSetSource
  createdByUserId String?
  conversationId  String?
  summary         String
  ops             Json
  baseCommit      String
  status          ChangeSetStatus @default(DRAFT)
  version         Int             @default(0)
  error           String?
  publishedCommit String?
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  builds       Build[]

  @@index([siteId, status])
  @@index([siteId, createdAt])
  @@map("change_sets")
}

enum ChangeSetSource {
  QUICK_EDIT
  OPERATOR
  EDITOR // The visual editor's canvas (PRD D35)
}

enum ChangeSetStatus {
  DRAFT
  PREVIEWED
  PUBLISHED
  DISCARDED
  FAILED
}

// A preview build of a ChangeSet, made by apps/builder. Publish points the
// live site at a succeeded build without rebuilding it.
model Build {
  id           String      @id @default(cuid())
  siteId       String
  changeSetId  String?
  status       BuildStatus @default(QUEUED)
  draftVersion Int? // The ChangeSet version this build is of; publish needs the current one
  baseCommit   String?
  error        String?
  log          String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime    @default(now())

  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  changeSet ChangeSet? @relation(fields: [changeSetId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([changeSetId])
  @@map("builds")
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SUPERSEDED // A newer save of the same draft replaced it before it started
}

// A quick edit conversation (E32): the model's message history, its token
// use, and the estimated spend, per account through its site (PRD D7, D21).
model Conversation {
  id               String   @id @default(cuid())
  siteId           String
  userId           String?
  model            String
  messages         Json     @default("[]")
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Decimal  @default(0) @db.Decimal(12, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site       Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  changeSets ChangeSet[]

  @@index([siteId, createdAt])
  @@map("conversations")
}

// Form configuration
model Form {
  id                        String    @id @default(cuid())
  accountId                 String
  createdByUserId           String? // Null once the creator's user is deleted; the form stays with the account
  name                      String
  title                     String?
  description               String?
  slug                      String // Account-unique, for admin URLs
  allowedOrigins            String[]  @default([]) // Domains allowed to embed/submit to this form
  notifyEmails              String[]  @default([])
  emailNotificationsEnabled Boolean   @default(false) // Epic 4: Email account owner on new submission
  emailIncludeResponses     Boolean   @default(false) // Epic 26: Include submitted values + Reply-To in notification emails
  honeypotField             String? // Optional honeypot field name
  successMessage            String?
  redirectUrl               String?
  defaultTheme              Json?
  stopAt                    DateTime? // Stop accepting submissions after this date/time
  maxSubmissions            Int? // Maximum number of submissions allowed
  published                 Boolean   @default(false) // Whether the form is accessible via hosted URL (/f/[formId])
  thumbnail                 Bytes? // JPEG thumbnail captured client-side from preview
  type                      FormType // Whether the form is delivered via hosted page or embed snippet (locked at creation)
  createdAt                 DateTime  @default(now())

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdByUser User?          @relation("CreatedForms", fields: [createdByUserId], references: [id], onDelete: SetNull)
  fields        Field[]
  submissions   Submission[]
  notifications Notification[]

  @@unique([accountId, slug])
  @@index([accountId])
  @@index([createdByUserId])
  @@map("forms")
}

model Field {
  id          String    @id @default(cuid())
  formId      String
  name        String
  type        FieldType
  label       String
  placeholder String?
  required    Boolean   @default(false)
  order       Int
  options     Json?
  validation  Json?
  helpText    String?

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, name])
  @@index([formId, order])
  @@map("fields")
}

// Form submission
model Submission {
  id        String           @id @default(cuid())
  formId    String
  data      Json // Arbitrary form payload
  meta      Json // IP hash, user agent, referrer, origin
  isSpam    Boolean          @default(false)
  status    SubmissionStatus @default(NEW)
  createdAt DateTime         @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([status])
  @@index([isSpam])
  @@map("submissions")
}

enum SubmissionStatus {
  NEW
  READ
  ARCHIVED
}

enum FieldType {
  TEXT
  EMAIL
  TEXTAREA
  DROPDOWN
  CHECKBOX
  CHECKBOXES
  PHONE
  DATE
  NAME
  NUMBER
  ADDRESS
}

enum FormType {
  HOSTED
  EMBEDDED
}

// In-app notifications (bell). Dismiss-on-interaction — no retention.
// One row per (accountId, formId, type); NEW_SUBMISSION increments `count`.
model Notification {
  id        String           @id @default(cuid())
  accountId String
  formId    String
  type      NotificationType
  count     Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  form    Form    @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([accountId, formId, type])
  @@index([accountId, updatedAt])
  @@map("notifications")
}

enum NotificationType {
  NEW_SUBMISSION
  LIMIT_MAX_REACHED
  LIMIT_DEADLINE_REACHED
}

// A signed-in browser. The cookie holds a random token; only its SHA-256 is
// stored (as the id), so a database read yields no usable session. Idle
// expiry rolls forward on use, never past absoluteExpiresAt. Deleting the row
// signs that browser out. See src/lib/session.ts.
model Session {
  id                String   @id // SHA-256 hex of the cookie token
  userId            String
  rememberMe        Boolean
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// A one-time pass from sign-in on the Forms host to a session on the Sites
// host, for a Sites account that signed in on the wrong host (PRD D22). Like
// sessions, only the token's SHA-256 is stored. Single use, two minutes, and
// good only on the host it names. See src/lib/session.ts.
model SessionHandoff {
  id         String   @id // SHA-256 hex of the token
  userId     String
  rememberMe Boolean
  targetHost String
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session_handoffs")
}

// Password reset tokens. The emailed link carries a random token; only its
// SHA-256 is stored, so a database read yields no working link. Issuing a new
// one invalidates the user's older ones; consuming one is a single
// conditional update, so a link works once.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
