// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// The tenant: forms, plan, and (from E29) sites belong to an Account. Users
// reach it through Membership; nothing in the UI names the Account itself.
model Account {
  id                     String        @id @default(cuid())
  createdAt              DateTime      @default(now())
  planCode               String        @default("FREE")
  requiresPlanResolution Boolean       @default(false)
  // Billing state, set by an operator (PRD D12). Billing itself happens
  // outside the portal; billingRef points there. Status gates nothing yet.
  status                 AccountStatus @default(ACTIVE)
  billingRef             String?
  // IANA zone of the business. Emails state times in it, and its site's dates
  // follow it: the builder rebuilds at its local midnight (PRD D42). Signup
  // records the browser's; UTC is an account nobody has told us the zone of.
  timeZone               String        @default("UTC")

  plan          Plan           @relation(fields: [planCode], references: [code])
  memberships   Membership[]
  forms         Form[]
  notifications Notification[]
  site          Site?
  actAs         ActAs[]

  @@index([planCode])
  @@map("accounts")
}

// Plan catalog. Rows are seeded via migration; not user-editable at runtime.
// Account.planCode references Plan.code. Entitlements live as typed columns
// so each future entitlement is an explicit migration, not a hidden JSON
// shape change. Read them through getAccountEntitlements.
model Plan {
  code              String  @id
  displayName       String
  description       String?
  maxPublishedForms Int?
  // Canopy Sites: Sites chrome, /editor and /stats, and owning a Site.
  // Only SITES has it. The catalog is FREE, PAID ("Unlimited"), and SITES.
  sitesEnabled      Boolean @default(false)
  isPublic          Boolean @default(true)
  sortOrder         Int     @default(0)

  accounts Account[]

  @@map("plans")
}

// Role catalog. Seeded via migration; not user-editable at runtime.
// User.roleCode references Role.code. Capability flags land as typed columns
// when a second non-basic role ships.
model Role {
  code        String  @id
  displayName String
  description String?
  isPublic    Boolean @default(true)
  sortOrder   Int     @default(0)

  users User[]

  @@map("roles")
}

// Admin user account
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  // scrypt, or bcrypt from before Epic 28 (re-hashed on sign-in); src/lib/password.ts.
  // Null until the owner of an account the operator linked claims it (PRD D49):
  // no password exists to guess, and sign-in treats null as a wrong password.
  password  String?
  createdAt DateTime @default(now())
  roleCode  String   @default("USER")

  memberships Membership[]

  role Role @relation(fields: [roleCode], references: [code])

  // Auth telemetry
  lastLoginAt       DateTime?
  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  passwordChangedAt DateTime?

  createdForms          Form[]           @relation("CreatedForms")
  passwordTokens        PasswordToken[]  @relation("PasswordTokens")
  passwordTokensCreated PasswordToken[]  @relation("PasswordTokensCreated")
  actingAs              ActAs[]
  sessions              Session[]
  sessionHandoffs       SessionHandoff[]
  changeSets            ChangeSet[]
  conversations         Conversation[]
  helpRequestsSent      HelpRequest[]    @relation("HelpRequestSender")
  helpRequestsClosed    HelpRequest[]    @relation("HelpRequestCloser")

  @@index([roleCode])
  @@map("users")
}

// A user's access to an account. v1 gives every user exactly one membership,
// as OWNER; getCurrentAccountId enforces that. Platform roles (GLOBAL_ADMIN)
// stay on User.roleCode, separate from this per-account role.
model Membership {
  id        String         @id @default(cuid())
  userId    String
  accountId String
  role      MembershipRole
  createdAt DateTime       @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([accountId])
  @@map("memberships")
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum AccountStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

// A Canopy Sites website: one per account (PRD D19), only on a plan with
// sitesEnabled. Holds what the operator records about the site; the repo,
// DNS, and Umami website are made by hand. Clients see only id, name, and
// slug (getAccountSite); everything else is operator configuration.
// An account that owns a site cannot be deleted (Restrict): the row will
// drive the client's live hosting from E30 on.
model Site {
  id                  String   @id @default(cuid())
  accountId           String   @unique
  slug                String   @unique // Fixed at creation: names /srv/sites/<slug> (and the builder's GIT_TOKEN_<SLUG> fallback)
  name                String
  repoUrl             String?
  defaultBranch       String   @default("main")
  productionHostnames String[] @default([]) // Lowercase; no hostname belongs to two sites (checked in the action)
  contractVersion     String? // site-contract version the repo implements (MAJOR.MINOR.PATCH)
  umamiWebsiteId      String?
  lockedFields        String[] @default([]) // Address patterns no owner edit may change (PRD D50), e.g. site/contact/phone
  fixedLists          String[] @default([]) // Address patterns of lists whose entries no owner edit adds, removes, or reorders (PRD D50), e.g. classes
  maxBuildsRetained   Int      @default(5)
  // A sales demo, never a client's site (PRD D23): Stats shows sample data.
  isDemo              Boolean  @default(false)
  // IANA zone for the site's dates: the builder rebuilds at its local midnight (PRD D42)
  timeZone            String   @default("America/Los_Angeles")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  changeSets    ChangeSet[]
  builds        Build[]
  conversations Conversation[]
  helpRequests  HelpRequest[]

  @@map("sites")
}

// One proposed edit to a site's content, from any source (PRD section 4.5).
// ops are @canopy/site-contract ChangeOps against the branch at baseCommit.
// A site has at most one pending (DRAFT or PREVIEWED) change at a time: the
// site's draft (PRD D38), which every source writes. version counts its
// saves, and publish needs a build of the current one.
model ChangeSet {
  id              String          @id @default(cuid())
  siteId          String
  source          ChangeSetSource
  createdByUserId String?
  conversationId  String?
  summary         String
  ops             Json
  baseCommit      String
  status          ChangeSetStatus @default(DRAFT)
  version         Int             @default(0)
  error           String?
  publishedCommit String?
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  builds       Build[]

  @@index([siteId, status])
  @@index([siteId, createdAt])
  @@map("change_sets")
}

enum ChangeSetSource {
  QUICK_EDIT
  OPERATOR
  EDITOR // The visual editor's canvas (PRD D35)
}

enum ChangeSetStatus {
  DRAFT
  PREVIEWED
  PUBLISHED
  DISCARDED
  FAILED
}

// A preview build of a ChangeSet, made by apps/builder. Publish points the
// live site at a succeeded build without rebuilding it.
model Build {
  id           String      @id @default(cuid())
  siteId       String
  changeSetId  String?
  status       BuildStatus @default(QUEUED)
  draftVersion Int? // The ChangeSet version this build is of; publish needs the current one
  baseCommit   String?
  error        String?
  log          String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime    @default(now())

  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  changeSet ChangeSet? @relation(fields: [changeSetId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([changeSetId])
  @@map("builds")
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SUPERSEDED // A newer save of the same draft replaced it before it started
}

// A quick edit conversation (E32): the model's message history, its token
// use, and the estimated spend, per account through its site (PRD D7, D21).
model Conversation {
  id               String   @id @default(cuid())
  siteId           String
  userId           String?
  model            String
  messages         Json     @default("[]")
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Decimal  @default(0) @db.Decimal(12, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  changeSets   ChangeSet[]
  helpRequests HelpRequest[]

  @@index([siteId, createdAt])
  @@map("conversations")
}

// Something an owner asked for that Quick Edit can't do, sent to Canopy
// (PRD D34, Epic 40 4.3). Quick Edit drafts it in the owner's words; the
// owner sends it from a card, or dismisses it, and only a sent request reaches
// the operator. One sent while an operator acts as the client is theirs, and
// emails nobody.
model HelpRequest {
  id              String            @id @default(cuid())
  siteId          String
  conversationId  String?
  // Who sent it: the owner, or the operator acting as them (then actAsId is set).
  createdByUserId String?
  actAsId         String?
  // The owner's own words, and a one-line summary of them.
  message         String
  summary         String
  // The field it's about, when there is one (PRD D36).
  address         String?
  // Text Quick Edit won't put on the site (swearing, hate speech, nothing to
  // do with the business). Like any request, it reaches Canopy only if the
  // owner sends it.
  refused         Boolean           @default(false)
  status          HelpRequestStatus @default(DRAFT)
  sentAt          DateTime?
  // Canopy's reply, emailed to the sender when the request is closed with one.
  note            String?
  closedByUserId  String?
  closedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("HelpRequestSender", fields: [createdByUserId], references: [id], onDelete: SetNull)
  actAs        ActAs?        @relation(fields: [actAsId], references: [id], onDelete: SetNull)
  closedBy     User?         @relation("HelpRequestCloser", fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@index([siteId, status])
  @@index([status, sentAt])
  @@map("help_requests")
}

enum HelpRequestStatus {
  DRAFT // Drafted by Quick Edit; the owner hasn't sent it
  OPEN // Sent; Canopy hasn't closed it
  DONE
  DECLINED
  DISMISSED // The owner chose Not now; never reached Canopy
}

// Form configuration
model Form {
  id                        String    @id @default(cuid())
  accountId                 String
  createdByUserId           String? // Null once the creator's user is deleted; the form stays with the account
  name                      String
  title                     String?
  description               String?
  slug                      String // Account-unique, for admin URLs
  allowedOrigins            String[]  @default([]) // Domains allowed to embed/submit to this form
  notifyEmails              String[]  @default([])
  emailNotificationsEnabled Boolean   @default(false) // Epic 4: Email account owner on new submission
  emailIncludeResponses     Boolean   @default(false) // Epic 26: Include submitted values + Reply-To in notification emails
  honeypotField             String? // Optional honeypot field name
  successMessage            String?
  redirectUrl               String?
  defaultTheme              Json?
  stopAt                    DateTime? // Stop accepting submissions after this date/time
  maxSubmissions            Int? // Maximum number of submissions allowed
  published                 Boolean   @default(false) // Whether the form is accessible via hosted URL (/f/[formId])
  thumbnail                 Bytes? // JPEG thumbnail captured client-side from preview
  type                      FormType // Whether the form is delivered via hosted page or embed snippet (locked at creation)
  createdAt                 DateTime  @default(now())

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdByUser User?          @relation("CreatedForms", fields: [createdByUserId], references: [id], onDelete: SetNull)
  fields        Field[]
  submissions   Submission[]
  notifications Notification[]

  @@unique([accountId, slug])
  @@index([accountId])
  @@index([createdByUserId])
  @@map("forms")
}

model Field {
  id          String    @id @default(cuid())
  formId      String
  name        String
  type        FieldType
  label       String
  required    Boolean   @default(false)
  order       Int
  options     Json?
  validation  Json?
  helpText    String?

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, name])
  @@index([formId, order])
  @@map("fields")
}

// Form submission
model Submission {
  id        String           @id @default(cuid())
  formId    String
  data      Json // Arbitrary form payload
  meta      Json // IP hash, user agent, referrer, origin
  isSpam    Boolean          @default(false)
  status    SubmissionStatus @default(NEW)
  createdAt DateTime         @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([status])
  @@index([isSpam])
  @@map("submissions")
}

enum SubmissionStatus {
  NEW
  READ
  ARCHIVED
}

enum FieldType {
  TEXT
  EMAIL
  TEXTAREA
  CHOOSE_ONE
  APPROVAL
  CHOOSE_SEVERAL
  PHONE
  DATE
  NAME
  NUMBER
  ADDRESS
  DATE_OF_BIRTH
  WEBSITE
}

enum FormType {
  HOSTED
  EMBEDDED
}

// In-app notifications (bell). Dismiss-on-interaction — no retention.
// One row per (accountId, formId, type); NEW_SUBMISSION increments `count`.
model Notification {
  id        String           @id @default(cuid())
  accountId String
  formId    String
  type      NotificationType
  count     Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  form    Form    @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([accountId, formId, type])
  @@index([accountId, updatedAt])
  @@map("notifications")
}

enum NotificationType {
  NEW_SUBMISSION
  LIMIT_MAX_REACHED
  LIMIT_DEADLINE_REACHED
}

// A signed-in browser. The cookie holds a random token; only its SHA-256 is
// stored (as the id), so a database read yields no usable session. Idle
// expiry rolls forward on use, never past absoluteExpiresAt. Deleting the row
// signs that browser out. See src/lib/session.ts.
model Session {
  id                String   @id // SHA-256 hex of the cookie token
  userId            String
  rememberMe        Boolean
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime

  // Set while a Global Admin acts as a client in this browser (PRD D49).
  actAsId String?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  actAs ActAs? @relation(fields: [actAsId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([actAsId])
  @@map("sessions")
}

// A Global Admin inside a client's account, for acceptance, support, or
// building a form, never with the client's password (PRD D49). The row is the
// record of who was in which account when; writes made meanwhile name the
// operator wherever a row names its author (a ChangeSet, a form's creator, a
// published commit).
model ActAs {
  id             String    @id @default(cuid())
  // Null once the operator's user is deleted; the record stays.
  operatorUserId String?
  accountId      String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  operator     User?         @relation(fields: [operatorUserId], references: [id], onDelete: SetNull)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessions     Session[]
  helpRequests HelpRequest[]

  @@index([accountId])
  @@index([operatorUserId])
  @@map("act_as")
}

// A one-time pass from sign-in on the Forms host to a session on the Sites
// host, for a Sites account that signed in on the wrong host (PRD D22). Like
// sessions, only the token's SHA-256 is stored. Single use, two minutes, and
// good only on the host it names. See src/lib/session.ts.
model SessionHandoff {
  id         String   @id // SHA-256 hex of the token
  userId     String
  rememberMe Boolean
  targetHost String
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session_handoffs")
}

// A link that sets a password: a reset, or the claim of an account the
// operator linked (PRD D49). The link carries a random token; only its SHA-256
// is stored, so a database read yields no working link. Issuing a new one
// invalidates the user's older ones of either purpose; consuming one is a
// single conditional update, so a link works once. "Link sent" and "claimed"
// are the newest claim's createdAt and usedAt.
model PasswordToken {
  id              String               @id @default(cuid())
  userId          String
  purpose         PasswordTokenPurpose @default(RESET)
  tokenHash       String               @unique
  expiresAt       DateTime
  usedAt          DateTime?
  // The operator who made a claim link; null when the owner asked for it
  // through Forgot password.
  createdByUserId String?
  // When the portal emailed it; null for a link the operator copied.
  emailedAt       DateTime?
  createdAt       DateTime             @default(now())

  user      User  @relation("PasswordTokens", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PasswordTokensCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum PasswordTokenPurpose {
  RESET
  CLAIM
}
