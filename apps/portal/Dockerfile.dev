# syntax=docker/dockerfile:1
# Build context is the repo root (npm workspaces). docker-compose.dev.yml
# bind-mounts the repo over /app, so the COPY below only seeds the image.

FROM node:20-alpine

# Install dependencies
RUN apk add --no-cache libc6-compat

# Run as the image's `node` user, uid 1000, the same as the developer's on the
# host: what the container writes on the bind mount (.next, migrations, build
# output) is then the developer's, not root's. It owns /app and /srv/media in
# the image because a new named volume takes its owner from the image.
RUN mkdir -p /app /srv/media && chown node:node /app /srv/media
USER node
WORKDIR /app

# Workspace manifests (node_modules is preserved by a named volume in docker-compose)
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node apps/portal/package.json ./apps/portal/
COPY --chown=node:node apps/builder/package.json ./apps/builder/
COPY --chown=node:node packages/site-contract/package.json ./packages/site-contract/
COPY --chown=node:node apps/portal/scripts/check-optional-packages.mjs ./apps/portal/scripts/

# Fails the layer when npm left out an optional package (see
# apps/portal/Dockerfile), so a new node_modules volume is never filled from
# an install without one
RUN npm ci && node apps/portal/scripts/check-optional-packages.mjs

# Copy source code (will be overridden by volume mount in dev mode)
COPY --chown=node:node . .

WORKDIR /app/apps/portal

# Generate Prisma Client for a new node_modules volume (the entrypoint
# generates it again on every start)
RUN npx prisma generate || true

# Build embed script (will be rebuilt if needed)
RUN npm run embed:build || true

# Expose port
EXPOSE 3000

# NOTE: Do NOT set NODE_ENV here. next dev sets it to "development" automatically,
# and leaving it unset allows next build to set "production" when running build
# verification inside the dev container.

# Entrypoint. Dependencies are installed only when the node_modules volume has
# no next. An install that failed, or that npm finished without an optional
# package, stops the container, and next's bin comes back out so the next
# start installs again: that install leaves the bin in place, and compose
# restarts a stopped container, which would otherwise skip the install and
# serve from that volume. The Prisma client is generated on every start, so it
# follows prisma/schema.prisma and a restart is all a schema change needs; a
# schema that does not generate still lets the server start.
COPY --chmod=755 <<'EOF' /entrypoint.sh
#!/bin/sh
if [ ! -f /app/node_modules/.bin/next ]; then
  echo "Installing dependencies..."
  if ! (cd /app && npm ci && node apps/portal/scripts/check-optional-packages.mjs); then
    rm -f /app/node_modules/.bin/next
    echo "The install did not complete. The next start runs it again."
    exit 1
  fi
  npm run embed:build
fi
npm run db:generate
exec npm run dev
EOF

CMD ["/entrypoint.sh"]
